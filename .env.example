# --- API keys（scan で使うエンジン分は必須） ---
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# questions / 抽出 / 改善提案 / Claude エンジンで使用
ANTHROPIC_API_KEY=

# --- 任意 ---
# 費用換算レート（1ドル=円）。既定 150
USD_JPY=150
# scan の --max-cost 既定値（円）。既定 500
# GEO_SCAN_MAX_COST=1000
# 各エンジンのモデル（既定値と料金は src/lib/pricing.ts、根拠は docs/api-notes.md）
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# GEMINI_MODEL=gemini-3.5-flash
# PERPLEXITY_MODEL=sonar
# ANTHROPIC_MODEL=claude-sonnet-5
# 抽出（Haiku）と質問生成・改善提案（Opus）のモデル
# ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5
# ANTHROPIC_WRITER_MODEL=claude-opus-5
# puppeteer が Chrome を見つけられない時に指定
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 1 にすると API を呼ばず fixtures のモック回答で動く（開発用）
# GEO_SCAN_MOCK=1
